<?xml version="1.0" encoding="utf-8"?>
<!--
  Dumps BWAPI's view of StarCraft's memory. See bw_layout_dump.cpp.

  The compile settings below are BWAPI.vcxproj's, deliberately: a layout is only meaningful if it
  is the layout the shipped DLL was built with, so the include directories, the preprocessor
  definitions and the language standard have to be the same. If they ever drift apart, this dump
  stops describing the DLL - so treat any edit to BWAPI.vcxproj's ClCompile settings as an edit to
  this file too.
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{7E1D0C4A-9B3F-4A21-8C5E-2D6F0B4A9E13}</ProjectGuid>
    <RootNamespace>BWLayoutDump</RootNamespace>
    <Keyword>Win32Proj</Keyword>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <!--
    Anchored to this file rather than to $(SolutionDir), which is only bwapi/ when msbuild is
    handed bwapi.sln. CI builds this project on its own, where $(SolutionDir) is the project
    directory - so name the directory outright and the output is in the same place either way.
  -->
  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)Release\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)Release\obj\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <AdditionalIncludeDirectories>../../Shared;../../BWAPI/Source/BWAPI;../../Util/Source;../../BWAPI/Source;../../include;../../Storm;../../BWAPICore;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NOMINMAX;WIN32;_WIN32_WINNT=0x0601;NTDDI_VERSION=0x06010000;NDEBUG;_WINDOWS;_CRT_SECURE_NO_DEPRECATE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <WarningLevel>Level3</WarningLevel>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <DisableSpecificWarnings>4100;4458;4189</DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <TargetMachine>MachineX86</TargetMachine>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="bw_layout_dump.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
