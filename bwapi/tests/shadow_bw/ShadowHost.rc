// BWAPI reads the host executable's version resource in CheckVersion() and refuses to apply the
// version-dependent half of ApplyCodePatches - the interesting half - unless it reads 1.16.1. It
// also raises a modal MessageBox when it does not, which under CI is a hang and not a failure.
//
// So this fixture declares 1.16.1.1. It is not StarCraft and does not pretend to be to anything but
// that one check; the strings below say so, and it never leaves the build directory.

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,16,1,1
 PRODUCTVERSION 1,16,1,1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "BWAPI test fixture"
            VALUE "FileDescription",  "Shadow StarCraft host - a test fixture, not StarCraft"
            VALUE "FileVersion",      "1.16.1.1"
            VALUE "InternalName",     "ShadowHost"
            VALUE "LegalCopyright",   "LGPL-3.0-only, as BWAPI"
            VALUE "OriginalFilename", "ShadowHost.exe"
            VALUE "ProductName",      "Shadow StarCraft host"
            VALUE "ProductVersion",   "1.16.1.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
